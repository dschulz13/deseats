############ Call the DeSeaTS function
source("DeSeaTS-SP06.ssc")

########### Input the data 
x<-read.table("Trust-OASI-Year.txt")

Year<-x[,1]
y<-x[,2]
#y<-log(y)

######### Privide the smoothing parameters
s<-1
p<-3
kn<-2
h<-9

ye<-DeSeaTS(y, s, p, kn, h)

matplot(Year, cbind(y, ye), type="l", lty=c(3, 1), col=c(5,3)) 
